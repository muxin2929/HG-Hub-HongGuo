# 生产构建示例：复制成 web/.env.production 后填写你自己的地址。
#
# App 内页面跑在虚拟域名 appassets.androidplatform.net 上，
# 相对路径的 /api、/img、/media 会打到虚拟域名，所以必须写绝对地址。
# 网页本身也部署在同一个域名下，绝对地址不会跨域。
#
# 不要把真实的服务器 IP、SSH 端口、面板地址写进这个文件并提交。

VITE_MOCK=0

# 网关 / API 地址（你自己的 HTTPS 域名）
VITE_API_BASE=https://your-domain.example

# 分享链接使用的公开站点地址（通常与 VITE_API_BASE 相同）
VITE_PUBLIC_ORIGIN=https://your-domain.example

# 可选：前端版本号，用于更新提示
# VITE_APP_VERSION=1.5.46
